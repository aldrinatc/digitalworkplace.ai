{
  "name": "digitalworkplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:main": "turbo dev --filter=@digitalworkplace/main",
    "dev:intranet": "turbo dev --filter=@digitalworkplace/intranet-iq",
    "dev:chatcore": "turbo dev --filter=@digitalworkplace/chat-core-iq",
    "build": "turbo build",
    "build:main": "turbo build --filter=@digitalworkplace/main",
    "build:intranet": "turbo build --filter=@digitalworkplace/intranet-iq",
    "build:chatcore": "turbo build --filter=@digitalworkplace/chat-core-iq",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "test:reliability": "node --experimental-strip-types --test scripts/ai-runtime.test.mjs"
  },
  "devDependencies": {
    "@vercel/oidc": "3.1.0",
    "jose": "6.1.3",
    "postgres": "3.4.9",
    "tsx": "4.20.5",
    "turbo": "^2.5.4"
  },
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=18"
  }
}
